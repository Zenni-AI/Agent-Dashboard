# --- Required ------------------------------------------------------------
# console.anthropic.com -> API keys. This stays on the server; the phone
# never sees it.
ANTHROPIC_API_KEY=

# Only needed if your key is "identity-linked" — org-scoped and tied to a user
# rather than to a workspace. If requests fail with "anthropic-workspace-id is
# required", put your workspace id here (console.anthropic.com -> Settings ->
# Workspaces). A key created inside a workspace does not need this.
ANTHROPIC_WORKSPACE_ID=

# --- Optional ------------------------------------------------------------
HIGH_THOUGHTS_MODEL=claude-opus-5

# Where the server listens. 0.0.0.0 so your phone can reach it over the LAN.
PORT=8080
HOST=0.0.0.0

# Per-IP throttle. In-memory, per process — enough to stop one person holding
# the button down, not a substitute for a real gateway on a public deploy.
HIGH_THOUGHTS_RATE_LIMIT=30
HIGH_THOUGHTS_RATE_WINDOW_MS=60000

# Longest thought accepted, and how many earlier turns are replayed as
# context when you come back to a thought.
HIGH_THOUGHTS_MAX_CHARS=4000
HIGH_THOUGHTS_MAX_HISTORY=6

# --- The credit ledger ---------------------------------------------------
# A creation costs real money, so the server will not make one without a
# credit. Two stores, same behaviour:
#
#   file      a JSON file. Right for one laptop. Single-process, and it lives
#             on the container's disk, so a redeploy can take everybody's
#             credits with it.
#   supabase  Postgres. Right for anything other people can reach: it survives
#             a redeploy, and a spend cannot be double-charged.
#
# Leave HIGH_THOUGHTS_LEDGER unset and setting both SUPABASE_ values below
# switches it to Postgres on its own.
HIGH_THOUGHTS_LEDGER=file
HIGH_THOUGHTS_CREDITS_FILE=.high-thoughts/credits.json

# Project settings -> API. The service role key bypasses row-level security,
# so it belongs on the server and nowhere else — never in the app, never in a
# repo. Apply supabase/migrations/0001_credit_ledger.sql before switching over.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The free first creation. Off by default, because every creation is a real
# bill. Switching it on requires a salt: the claim key is a hash of the
# caller's address, and an unsalted one is reversible by anyone with a list of
# addresses. Any long random string will do — `openssl rand -hex 32`.
HIGH_THOUGHTS_FREE_CLAIMS=0
HIGH_THOUGHTS_CLAIM_SALT=
HIGH_THOUGHTS_FREE_CREDITS=1
