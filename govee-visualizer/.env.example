# ---------- Google Maps Platform (https://console.cloud.google.com/google/maps-apis) ----------
# Server key: enable "Geocoding API" and "Street View Static API". Restrict it to those two APIs.
GOOGLE_MAPS_SERVER_KEY=
# Browser key: enable "Maps JavaScript API" and "Places API (New)". Restrict it by HTTP referrer
# to your domain (e.g. https://lights.example.com/*). Powers the address autocomplete dropdown.
GOOGLE_MAPS_BROWSER_KEY=
# Countries the address autocomplete suggests from (comma separated ISO codes).
ADDRESS_REGIONS=us

# ---------- AI image generation ----------
# gemini (recommended), openai, or mock (free placeholder renders for testing).
# Leave blank to auto-pick: gemini if GEMINI_API_KEY is set, else openai, else mock.
IMAGE_PROVIDER=
GEMINI_API_KEY=
# gemini-2.5-flash-image is fast and cheap; gemini-3-pro-image-preview is higher quality, slower and pricier.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ---------- Capacity ----------
# How many renders run against the AI provider at once. Keep it under your provider's rate limit.
# Everyone else waits in line and sees their position. 10 concurrent x ~15s each = ~40 previews/minute.
MAX_CONCURRENT_GENERATIONS=10
MAX_QUEUE_LENGTH=1000
GENERATION_TIMEOUT_MS=120000
# Each design = one house photo rendered in every theme (3 AI images). Visitors can make extra designs by
# uploading a different photo ("Not your house?"). This caps designs per person, and so your AI spend.
MAX_DESIGNS_PER_LEAD=3
# Distance between lights described to the AI. Set this to match the kit you install.
LIGHT_SPACING_INCHES=12

# ---------- Text message (Twilio) ----------
# When a design is done we text the visitor a picture + link. Needs a Twilio number that is registered for
# A2P 10DLC (US) or a verified toll-free number, plus PUBLIC_BASE_URL on https (carriers fetch the picture).
# Texting is OFF until this is true. Fill in the Twilio settings any time, then flip this once your
# A2P 10DLC (or toll-free) registration is approved. Until then, visitors get their designs by email only.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Or send through a Messaging Service instead of a single number:
TWILIO_MESSAGING_SERVICE_SID=

# ---------- Email ----------
# Any SMTP provider (Resend, SendGrid, Postmark, Mailgun, Amazon SES, Google Workspace...).
# Example: smtps://resend:re_xxxxx@smtp.resend.com:465
SMTP_URL=
EMAIL_FROM=Bright Home Lighting <designs@yourdomain.com>

# ---------- Leads ----------
# Download all leads at /admin/leads.csv (username: anything, password: this). Blank = disabled.
ADMIN_PASSWORD=
# Optional: every new lead and finished preview is POSTed here as JSON (Zapier, Make, GoHighLevel, HubSpot...).
LEAD_WEBHOOK_URL=

# ---------- Your business ----------
BUSINESS_NAME=Bright Home Lighting
BUSINESS_PHONE=
# Where the "Book a free quote" button goes (Calendly, your booking page...). Blank hides the button.
CTA_URL=
# Link to your privacy policy (shown under the form and in the footer). Google/Meta ads expect one.
PRIVACY_URL=

# ---------- Server ----------
PORT=3000
# Your public https URL. Required for texts and emails (they link back to the design page).
PUBLIC_BASE_URL=
# Set to 1 when running behind a load balancer / host proxy (Render, Railway, Fly, Heroku, Cloudflare),
# so rate limits see each visitor's real IP instead of the proxy's. Leave 0 if exposed directly.
TRUST_PROXY=0
# Where leads.db and generated images are stored. Must be a persistent disk in production.
DATA_DIR=./var
