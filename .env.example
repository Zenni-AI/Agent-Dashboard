# --- Required: public channel and video data ---------------------------------
# console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# --- Optional: your own retention, impressions and traffic sources ------------
# Owner-only data. console.cloud.google.com -> enable "YouTube Analytics API"
#   -> Credentials -> OAuth client ID -> Desktop app
# Add http://127.0.0.1:8788 as an authorised redirect URI.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_PORT=8788

# --- Optional: the strategy layer --------------------------------------------
# console.anthropic.com -> API keys. Without this, `litix run --no-advise`
# still produces the full computed report.
ANTHROPIC_API_KEY=
LITIX_MODEL=claude-opus-5

# --- Local state --------------------------------------------------------------
LITIX_CACHE_DIR=.litix-cache
LITIX_CACHE_TTL_HOURS=12
LITIX_TOKEN_FILE=.litix/tokens.json
