# --- Required ------------------------------------------------------------
# console.anthropic.com -> API keys. This stays on the server; the phone
# never sees it.
ANTHROPIC_API_KEY=

# --- Optional ------------------------------------------------------------
HIGH_THOUGHTS_MODEL=claude-opus-5

# Where the server listens. 0.0.0.0 so your phone can reach it over the LAN.
PORT=8080
HOST=0.0.0.0

# Per-IP throttle. In-memory, per process — enough to stop one person holding
# the button down, not a substitute for a real gateway on a public deploy.
HIGH_THOUGHTS_RATE_LIMIT=30
HIGH_THOUGHTS_RATE_WINDOW_MS=60000

# Longest thought accepted, and how many earlier turns are replayed as
# context when you come back to a thought.
HIGH_THOUGHTS_MAX_CHARS=4000
HIGH_THOUGHTS_MAX_HISTORY=6
